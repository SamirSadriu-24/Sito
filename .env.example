# ---------------------------------------------------------------------------
# Configurazione locale di sviluppo.
# Copia questo file in ".env" e adatta i valori. ".env" NON va committato.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- Porte esposte sull'host -------------------------------------------------
# Porta del sito WordPress (profilo Docker).
WP_PORT=8080
# Porta del database esposta sull'host dal container (solo DB_MODE=local):
# serve se vuoi collegarti con TablePlus / DBeaver / mysql-cli.
# Cambiala se la 3306 è già occupata. Con DB_MODE=external è ignorata:
# la porta del tuo server si indica dentro DB_HOST.
DB_PORT=3306
# Porta usata dal profilo Playground (SQLite, senza Docker).
PLAYGROUND_PORT=9400

# --- Database (solo profilo Docker) ------------------------------------------
# Dove vive il database:
#   local      database in container, dati nel volume Docker "db-data".
#              ATTENZIONE: "npm run docker:reset" cancella quel volume.
#   external   database su un server che gestisci tu. I dati restano sul tuo
#              server e non vengono toccati da nessun comando di questo progetto.
DB_MODE=local

# Host:porta del database. Usato solo con DB_MODE=external.
# Con DB_MODE=local lascialo com'è: il servizio interno si chiama "db".
#   DB sul PC che ospita Docker ...... host.docker.internal:3306
#   DB in rete locale ................ 192.168.1.50:3306
#   DB su server remoto o cloud ...... mio-server.esempio.it:3306
DB_HOST=db:3306

# Nome del database e credenziali applicative.
# Con DB_MODE=external il database e l'utente devono ESISTERE GIÀ sul tuo
# server, con permessi di accesso dalla rete Docker (non solo da localhost).
DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=wordpress

# Solo con DB_MODE=local: password di root del container del database.
DB_ROOT_PASSWORD=root

# Solo con DB_MODE=local. Immagine del database, alternative testate:
#   mariadb:11.4      (default, leggera)
#   mysql:8.4         (se ti serve MySQL "vero" per parità con la produzione)
DB_IMAGE=mariadb:11.4

# --- WordPress ---------------------------------------------------------------
WP_IMAGE=wordpress:php8.3-apache
WPCLI_IMAGE=wordpress:cli-php8.3
WP_TABLE_PREFIX=wp_
WP_DEBUG=1

# Credenziali create al primo "npm run docker:init".
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=admin
WP_ADMIN_EMAIL=dev@example.com
WP_SITE_TITLE=Rick Ferruzzi

# --- Playground (profilo senza Docker) ---------------------------------------
PLAYGROUND_PHP=8.3
PLAYGROUND_WP=latest
